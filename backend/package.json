{
  "name": "opshub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpsHub API + background worker (Node.js, Express, MongoDB)",
  "scripts": {
    "dev": "concurrently -k -n db,api,worker -c gray,blue,magenta \"npm run db\" \"npm run dev:api\" \"npm run dev:worker\"",
    "db": "tsx scripts/dev-db.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/workers/worker.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/workers/worker.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "migrate:payu": "tsx --env-file-if-exists=.env scripts/migrate-razorpay-to-payu.ts",
    "seed:100k": "tsx --env-file-if-exists=.env scripts/seed.ts --orders 100000 --reset",
    "explain": "tsx --env-file-if-exists=.env scripts/explain.ts",
    "load-test": "tsx scripts/load-test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
