# Copy to .env (optional). Defaults work out of the box with `npm run dev`.
NODE_ENV=development
API_PORT=3000

# Local replica set started by `npm run db` (scripts/dev-db.ts)
MONGODB_URI=mongodb://127.0.0.1:27027/opshub?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Where the web apps run (CORS + CSRF origin check); comma-separate several origins.
# Include both the admin app (frontend/) and the customer storefront (customer-web/).
WEB_ORIGIN=http://localhost:5173,http://localhost:4003

# Organization whose catalog the customer storefront (customer-web/) sells
STOREFRONT_ORG_SLUG=acme

# PayU India Hosted Checkout (online payments: UPI, cards, net banking, wallets). Leave key/salt empty for COD only.
# Test credentials: PayU dashboard (test mode) → Developers → API keys. Never commit real values.
# PAYU_SALT is server-only: it signs the checkout form and verifies PayU's response; it is never sent to a browser.
PAYU_MERCHANT_KEY=
PAYU_SALT=
# test → https://test.payu.in/_payment, production → https://secure.payu.in/_payment (only after PayU onboarding).
PAYU_ENV=test
PAYU_PAYMENT_URL=https://test.payu.in/_payment
# Public HTTPS URLs of the customer storefront (never localhost); PayU posts the result there.
# PAYU_SUCCESS_URL=https://<customer-public-host>/payment/success
# PAYU_FAILURE_URL=https://<customer-public-host>/payment/failure
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=
# Unpaid online orders are cancelled and their stock released after this many minutes.
PAYMENT_TIMEOUT_MINUTES=30

AUTO_SEED=true
# Optional: serve a built frontend from this server, e.g. ../frontend/dist
# WEB_DIST=../frontend/dist
