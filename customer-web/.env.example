# Existing OpsHub backend (the same one the admin app uses). Only /api/storefront/* is proxied to it,
# so the browser never talks to the backend directly and session cookies stay first-party.
# The backend's WEB_ORIGIN must include this app's origin (http://localhost:4003 in development).
API_URL=http://localhost:4500

# Payments: nothing to set here. Razorpay keys live only in backend/.env (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET);
# the backend returns the public key id together with each Razorpay order, so the checkout always uses the key
# that created the order and the secret never reaches the browser.

# Optional: storefront brand name shown in the header, footer and page titles (default "ShopNest").
# NEXT_PUBLIC_BRAND_NAME=ShopNest
